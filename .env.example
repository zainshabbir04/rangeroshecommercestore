# ============================================================================
# RANG E ROSH — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and update values for your environment
# ============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Security & Admin Authentication
# Change JWT_SECRET to a long random secret in production
JWT_SECRET=rang-e-rosh-super-secret-jwt-key-change-in-production-2026
ADMIN_DEFAULT_EMAIL=rangerosh.official@gmail.com
ADMIN_DEFAULT_PASSWORD=RangeRosh@Admin2026

# Store & WhatsApp Configuration (From supplied Website Detail.txt)
STORE_NAME="Rang e Rosh"
STORE_TAGLINE="Ladies Stitched Suits — Pret Collection"
STORE_EMAIL="rangerosh.official@gmail.com"
STORE_CONTACT_PHONE="+923 130 888 048"
STORE_SHIPPING_WHATSAPP="+923 200 300 552"

# Shipping & Inventory Defaults
DEFAULT_SHIPPING_CHARGE=250
FREE_SHIPPING_THRESHOLD=15000
DEFAULT_LOW_STOCK_THRESHOLD=5

# Database Path (SQLite persistent relational database)
DATABASE_PATH=./data/rangerosh.sqlite

# Optional Supabase Configuration (If deploying with Supabase PostgreSQL/Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
